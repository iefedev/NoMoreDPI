<ui:FluentWindow x:Class="NoMoreDPI.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:NoMoreDPI"
                 xmlns:pages="clr-namespace:NoMoreDPI.Pages"
                 Title="No More DPI" Width="1100" Height="760" MinWidth="820" MinHeight="560"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
  <ui:FluentWindow.Resources>
    <local:VisibleConverter x:Key="Visible" />
  </ui:FluentWindow.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Title="No More DPI" Grid.Row="0">
      <ui:TitleBar.Icon>
        <ui:SymbolIcon Symbol="ShieldGlobe24" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <!-- Pane always open: no hamburger toggle, no separator lines. -->
    <ui:NavigationView x:Name="Nav" Grid.Row="1"
                       PaneDisplayMode="Left"
                       IsBackButtonVisible="Collapsed"
                       IsPaneToggleVisible="False"
                       IsTopSeparatorVisible="False"
                       IsFooterSeparatorVisible="False"
                       OpenPaneLength="220">
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Content="Status" TargetPageType="{x:Type pages:StatusPage}">
          <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Home24" /></ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Content="Profiles" TargetPageType="{x:Type pages:ProfilesPage}">
          <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Globe24" /></ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Content="Advanced" TargetPageType="{x:Type pages:AdvancedPage}">
          <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Options24" /></ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
      </ui:NavigationView.MenuItems>
      <ui:NavigationView.FooterMenuItems>
        <ui:NavigationViewItem Content="Settings" TargetPageType="{x:Type pages:SettingsPage}">
          <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Settings24" /></ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
      </ui:NavigationView.FooterMenuItems>
    </ui:NavigationView>

    <!-- Unsaved edits on Profiles / Advanced -->
    <Border Grid.Row="2" Margin="16,0,16,16" Padding="16,12" CornerRadius="8" BorderThickness="1"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            Visibility="{Binding Dirty, Converter={StaticResource Visible}}">
      <DockPanel LastChildFill="False">
        <ui:SymbolIcon Symbol="Info24" DockPanel.Dock="Left" Margin="0,0,12,0" />
        <ui:TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="You have unsaved changes." />
        <ui:Button x:Name="SaveButton" DockPanel.Dock="Right" Appearance="Primary" Content="Save and apply" Click="Save_Click">
          <ui:Button.Icon><ui:SymbolIcon Symbol="Save24" /></ui:Button.Icon>
        </ui:Button>
        <ui:Button DockPanel.Dock="Right" Margin="0,0,8,0" Content="Discard" Click="Discard_Click" />
      </DockPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
