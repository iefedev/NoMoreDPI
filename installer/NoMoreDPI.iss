; Inno Setup 6 script. build.ps1 -Installer compiles it from the files in dist\:
;   iscc /DAppVersion=1.2.3 /DNumericVersion=1.2.3 /O..\dist NoMoreDPI.iss
; Setup copies the files; nomoredpi-svc.exe install/uninstall --setup registers the
; service, so the same code path serves setup and a manual install.

;   (build.ps1 -ProjectUrl adds /DAppUrl=https://...; without it setup shows no links)

#ifndef AppVersion
  #define AppVersion "1.0.0"
#endif
#ifndef NumericVersion
  #define NumericVersion "1.0.0"
#endif
#define AppName "No More DPI"
#define Dist "..\dist"

[Setup]
; Never change AppId: it is how upgrades find the installed copy.
AppId={{C088CE3B-18AF-400E-89EF-718F60C89410}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher=iefedev
AppCopyright=Copyright (c) 2026 iefedev
#ifdef AppUrl
AppPublisherURL={#AppUrl}
AppSupportURL={#AppUrl}/issues
AppUpdatesURL={#AppUrl}/releases
#endif
VersionInfoVersion={#NumericVersion}
VersionInfoProductName={#AppName}
DefaultDirName={autopf}\{#AppName}
DisableDirPage=auto
DefaultGroupName={#AppName}
DisableProgramGroupPage=yes
PrivilegesRequired=admin
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0.17763
WizardStyle=modern
SetupIconFile=..\assets\icon.ico
UninstallDisplayIcon={app}\NoMoreDPI.exe
UninstallDisplayName={#AppName}
LicenseFile=..\LICENSE
OutputBaseFilename=NoMoreDPI-{#AppVersion}-setup
Compression=lzma2/max
SolidCompression=yes
CloseApplications=yes

[Tasks]
Name: "autostart"; Description: "Show the tray icon when I sign in"
Name: "desktopicon"; Description: "Create a desktop shortcut"; Flags: unchecked

[Files]
Source: "{#Dist}\NoMoreDPI.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#Dist}\nomoredpi-svc.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#Dist}\ciadpi.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#Dist}\wintun.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\LICENSE"; DestDir: "{app}"; DestName: "LICENSE.txt"
Source: "..\THIRD-PARTY-NOTICES.md"; DestDir: "{app}"
; Full license texts: generated by build.ps1 from the exact dependency versions.
Source: "{#Dist}\THIRD-PARTY-LICENSES.txt"; DestDir: "{app}"
Source: "..\third_party\byedpi-bin\LICENSE"; DestDir: "{app}"; DestName: "byedpi-LICENSE.txt"
Source: "..\third_party\wintun\LICENSE.txt"; DestDir: "{app}"; DestName: "wintun-LICENSE.txt"

[Icons]
Name: "{autoprograms}\{#AppName}"; Filename: "{app}\NoMoreDPI.exe"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\NoMoreDPI.exe"; Tasks: desktopicon

[Run]
; Run as the signed-in user, not the elevated installer: the Run entry is per user.
Filename: "{app}\NoMoreDPI.exe"; Parameters: "--autostart on"; Tasks: autostart; Flags: runasoriginaluser waituntilterminated
Filename: "{app}\NoMoreDPI.exe"; Parameters: "--autostart off"; Tasks: not autostart; Flags: runasoriginaluser waituntilterminated
Filename: "{app}\NoMoreDPI.exe"; Description: "Open {#AppName}"; Flags: postinstall nowait runasoriginaluser skipifsilent

[UninstallRun]
; Before the files go: ends the tray, stops and deletes the service (which puts DNS and
; browser policies back), removes the Run entry.
Filename: "{app}\nomoredpi-svc.exe"; Parameters: "uninstall --setup"; Flags: runhidden waituntilterminated; RunOnceId: "RemoveService"

[Code]
function SetupErrorFile: String;
begin
  // nomoredpi-svc.exe writes it to its %TEMP% (same elevated user as setup).
  Result := ExpandConstant('{%TEMP}\nomoredpi-setup-error.txt');
end;

// Upgrade: the running service and tray lock the files we are about to replace.
function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  Svc: String;
  Code: Integer;
begin
  Result := '';
  Svc := ExpandConstant('{app}\nomoredpi-svc.exe');
  if FileExists(Svc) then
    Exec(Svc, 'prepare-upgrade --setup', '', SW_HIDE, ewWaitUntilTerminated, Code);
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  Code: Integer;
  Msg: AnsiString;
begin
  if CurStep <> ssPostInstall then
    exit;
  DeleteFile(SetupErrorFile);
  if Exec(ExpandConstant('{app}\nomoredpi-svc.exe'), 'install --setup', '', SW_HIDE, ewWaitUntilTerminated, Code) and (Code = 0) then
    exit;
  if not LoadStringFromFile(SetupErrorFile, Msg) then
    Msg := 'exit code ' + IntToStr(Code);
  Log('Service install failed: ' + String(Msg));
  SuppressibleMsgBox('No More DPI was copied, but its service could not be set up:' + #13#10#13#10 + String(Msg) + #13#10#13#10 +
    'Details are in ' + ExpandConstant('{%TEMP}\nomoredpi-install.log') + '. You can try again by running setup once more.',
    mbError, MB_OK, IDOK);
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep <> usPostUninstall then
    exit;
  if SuppressibleMsgBox('Also delete your No More DPI settings, profiles and logs?', mbConfirmation, MB_YESNO or MB_DEFBUTTON2, IDNO) = IDYES then
  begin
    DelTree(ExpandConstant('{commonappdata}\No More DPI'), True, True, True);
    DelTree(ExpandConstant('{userappdata}\No More DPI'), True, True, True);
    DelTree(ExpandConstant('{localappdata}\No More DPI'), True, True, True);
  end;
end;
